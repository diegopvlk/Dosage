#!@GJS@ -m

import GLib from "gi://GLib?version=2.0";

import { exit, programArgs, programInvocationName } from "system";

const prefix = GLib.getenv("DOSAGE_PREFIX") || "@prefix@";

imports.package.init({
  name: "@PACKAGE_NAME@",
  version: "@PACKAGE_VERSION@",
  prefix,
  libdir: GLib.getenv("DOSAGE_PREFIX") ? `${prefix}/lib` : "@libdir@",
  datadir: GLib.getenv("DOSAGE_PREFIX") ? `${prefix}/share` : "@datadir@",
});

const { main } = await import("resource://@resource_path@/js/main.js");
const exit_code = await main([programInvocationName, ...programArgs]);
exit(exit_code);
